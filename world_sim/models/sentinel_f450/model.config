<?xml version="1.0"?>
<model>
  <name>Sentinel F450 (OV5647 camera)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Sentinel V1</name>
    <email>sentinel@localhost</email>
  </author>

  <description>
    450 mm X-quad (DJI F450 style) for ArduPilot SITL in Gazebo.
    Equipped with a forward-facing OV5647-style camera (53.5 deg HFOV,
    640x480) that streams MPEG-TS via GstCameraPlugin to
    udp://127.0.0.1:5600 - the exact input the depth_node expects.
    Includes the ArduPilotPlugin (ports 9002/9003) for SITL.
  </description>
</model>
