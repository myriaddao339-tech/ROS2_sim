<?xml version='1.0'?>
<sdf version="1.9">
  <!--
    Sentinel F450 - 450 mm X-quad for ArduPilot SITL.

    Conventions copied from ardupilot_gazebo's iris_with_standoffs /
    iris_with_gimbal (same plugin, same frame rotations), with:
      - F450 geometry (motor-to-motor diagonal 0.45 m, 10" props)
      - fixed forward-facing OV5647-style camera, HFOV 53.5 deg,
        640x480, streamed via GstCameraPlugin to udp://127.0.0.1:5600
    Motor layout (X-quad, ArduPilot channel order):
      channel 0 -> rotor_0  front-right  CCW
      channel 1 -> rotor_1  rear-left   CCW
      channel 2 -> rotor_2  front-left  CW
      channel 3 -> rotor_3  rear-right  CW
  -->
  <model name="sentinel_f450">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <velocity_decay>
        <linear>0.0</linear>
        <angular>0.0</angular>
      </velocity_decay>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.011</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.011</iyy>
          <iyz>0</iyz>
          <izz>0.019</izz>
        </inertia>
      </inertial>

      <!-- top plate -->
      <collision name="top_plate_collision">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.17 0.17 0.012</size>
          </box>
        </geometry>
      </collision>
      <visual name="top_plate_visual">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.17 0.17 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- bottom plate -->
      <collision name="bottom_plate_collision">
        <pose>0 0 -0.038 0 0 0</pose>
        <geometry>
          <box>
            <size>0.17 0.17 0.012</size>
          </box>
        </geometry>
      </collision>
      <visual name="bottom_plate_visual">
        <pose>0 0 -0.038 0 0 0</pose>
        <geometry>
          <box>
            <size>0.17 0.17 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- battery (visual only) -->
      <visual name="battery_visual">
        <pose>-0.02 0 -0.056 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.04 0.028</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.15 0.45 1</ambient>
          <diffuse>0.08 0.15 0.45 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- arms (X layout, 45 deg) -->
      <collision name="arm_fl_collision">
        <pose>0.05 0.05 -0.026 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_fl_visual">
        <pose>0.05 0.05 -0.026 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="arm_fr_collision">
        <pose>0.05 -0.05 -0.026 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_fr_visual">
        <pose>0.05 -0.05 -0.026 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="arm_rl_collision">
        <pose>-0.05 0.05 -0.026 0 0 2.3562</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_rl_visual">
        <pose>-0.05 0.05 -0.026 0 0 2.3562</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="arm_rr_collision">
        <pose>-0.05 -0.05 -0.026 0 0 -2.3562</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_rr_visual">
        <pose>-0.05 -0.05 -0.026 0 0 -2.3562</pose>
        <geometry>
          <box>
            <size>0.19 0.03 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- motor pods -->
      <collision name="pod_fl_collision">
        <pose>0.159 0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pod_fl_visual">
        <pose>0.159 0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <collision name="pod_fr_collision">
        <pose>0.159 -0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pod_fr_visual">
        <pose>0.159 -0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <collision name="pod_rl_collision">
        <pose>-0.159 0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pod_rl_visual">
        <pose>-0.159 0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <collision name="pod_rr_collision">
        <pose>-0.159 -0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pod_rr_visual">
        <pose>-0.159 -0.159 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- landing skids -->
      <collision name="skid_fl_collision">
        <pose>0.11 0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="skid_fl_visual">
        <pose>0.11 0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="skid_fr_collision">
        <pose>0.11 -0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="skid_fr_visual">
        <pose>0.11 -0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="skid_rl_collision">
        <pose>-0.11 0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="skid_rl_visual">
        <pose>-0.11 0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="skid_rr_collision">
        <pose>-0.11 -0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="skid_rr_visual">
        <pose>-0.11 -0.11 -0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- IMU (conventions copied from iris_with_standoffs) -->
    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="revolute">
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- rotors: 10" props, X layout -->
    <link name="rotor_0">
      <pose>0.159 -0.159 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <child>rotor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_1">
      <pose>-0.159 0.159 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <child>rotor_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_2">
      <pose>0.159 0.159 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <child>rotor_2</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_3">
      <pose>-0.159 -0.159 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <child>rotor_3</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- forward-facing OV5647-style camera (pose copied from iris gimbal) -->
    <link name="camera_link">
      <pose degrees="true">0 -0.01 -0.10 90 0 90</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 -1.57 -1.57 0</pose>
        <camera>
          <!-- OV5647: 53.5 deg horizontal FOV (user spec) -->
          <horizontal_fov>0.93375</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>150</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- real OV5647 does 58.92 fps @ 640x480; 30 keeps sim CPU happy -->
        <update_rate>30</update_rate>
        <visualize>0</visualize>

        <!-- stream MPEG-TS to the depth_node's default UDP port.
             use_basic_pipeline MUST be false: true sends raw RTP H264,
             which the depth node's FFmpeg opener cannot demux. -->
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>false</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- ================= plugins ================= -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
