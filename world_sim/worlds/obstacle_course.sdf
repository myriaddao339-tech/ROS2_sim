<?xml version="1.0" ?>
<!--
  obstacle_course.sdf – Sentinel V1 ODA obstacle course (Gazebo Harmonic).

  Physics/plugins/NavSat origin based on ardupilot_gazebo's iris_runway.sdf.
  The world is SELF-CONTAINED: ground plane, drone model and obstacles use
  absolute paths, so it loads even without GZ_SIM_RESOURCE_PATH in the
  shell (fixes the empty-world bug).  The drone spawns at (0, 0, 0.195)
  with yaw 0 deg, facing +x (east) down the course.  NOTE: in this world
  +x = East and +y = North, so the model's forward +x axis must point
  along world +x to face the obstacles.

  Course layout (all distances along +x from spawn):
    WP1 x = 5   waypoint 1 (reached before the trigger range)
    x = 140..160 "box with one side open": a U-shaped enclosure of three
                2 m-thick, 50 m-tall walls (west x=140, east x=160,
                south y=-4), OPEN on the north side.  The 8 m-wide west
                wall fits fully inside the 53.5 deg camera FOV at the
                10 m detection range (ends at +/-22.8 deg < +/-26.8 deg
                half-FOV), so the Inner Map can chart it completely and
                A* routes around it through the north opening.
    WP2 x = 180 waypoint 2, just past the box and INSIDE the +/-200 m
                tile grid (the grid ends at x = 200, which is why the
                course was moved west from the old x = 200/550)
-->
<sdf version="1.9">
  <world name="obstacle_course">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- world axes + NavSat origin (required for SITL GPS) -->
    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <cast_shadows>0</cast_shadows>
          <pose>5 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.01 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="g">
          <cast_shadows>0</cast_shadows>
          <pose>0 5 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="b">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.01 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
            <emissive>0 0 1 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <!-- self-contained ground plane.  Replaces model://runway, whose mesh
         URIs still needed GZ_SIM_RESOURCE_PATH (empty-world bug). -->
    <model name="ground">
      <static>1</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>800 800 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>800 800 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.48 0.4 1</ambient>
            <diffuse>0.45 0.48 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- takeoff strip marking (visual only) -->
    <model name="runway_strip">
      <static>1</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="strip">
          <geometry>
            <box>
              <size>150 8 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.27 1</ambient>
            <diffuse>0.25 0.25 0.27 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- the drone: F450 with OV5647-style camera -->
    <include>
      <uri>/home/ubuntu/Desktop/ROS2_sim/world_sim/models/sentinel_f450</uri>
      <pose degrees="true">0 0 0.195 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- Simplified course: a single wall in front of the drone       -->
    <!-- (x = 140, y -4..4) blocking the direct route to the target   -->
    <!-- waypoint.  The A* path simply routes around either end.       -->
    <!-- ============================================================ -->
    <model name="box_west">
      <static>1</static>
      <pose>140 0 10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2 8 50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2 8 50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>

        <!-- floor stripes on the front face (visual only): give the
             depth model some texture to latch onto.  The visible stripe
             face sits slightly in front of the wall plane (x = -1). -->
        <visual name="stripe_1">
          <pose>-1.03 0 -3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 7.96 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.27 0.3 1</ambient>
            <diffuse>0.25 0.27 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="stripe_2">
          <pose>-1.03 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 7.96 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.27 0.3 1</ambient>
            <diffuse>0.25 0.27 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="stripe_3">
          <pose>-1.03 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 7.96 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.27 0.3 1</ambient>
            <diffuse>0.25 0.27 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>



  </world>
</sdf>
