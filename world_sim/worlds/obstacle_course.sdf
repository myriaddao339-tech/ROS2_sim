<?xml version="1.0" ?>
<!--
  obstacle_course.sdf – Sentinel V1 ODA obstacle course (Gazebo Harmonic).

  Physics/plugins/NavSat origin based on ardupilot_gazebo's iris_runway.sdf.
  The world is SELF-CONTAINED: ground plane, drone model and obstacles use
  absolute paths, so it loads even without GZ_SIM_RESOURCE_PATH in the
  shell (fixes the empty-world bug).  The drone spawns at (0, 0, 0.195)
  with yaw 0 deg, facing +x (east) down the course.  NOTE: in this world
  +x = East and +y = North, so the model's forward +x axis must point
  along world +x to face the obstacles.

  Course layout (all distances along +x from spawn):
    x = 10      gap-test walls: two 1 m wide walls with a 5 m gap
                (tests the Detection node's block split)
    x = 18      merge-test pair: two boxes 0.3 m apart (gap too narrow
                to fly through -> must be ONE block)
    x = 24-36   pylon slalom (r=0.15 m, 1.3 m tall)
    x = 42      corridor markers
    x = 44      long wall spanning y=-7..3 m, only passable on the right
    x = 52-56   box cluster + tall box
-->
<sdf version="1.9">
  <world name="obstacle_course">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- world axes + NavSat origin (required for SITL GPS) -->
    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <cast_shadows>0</cast_shadows>
          <pose>5 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.01 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="g">
          <cast_shadows>0</cast_shadows>
          <pose>0 5 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="b">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.01 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
            <emissive>0 0 1 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <!-- self-contained ground plane.  Replaces model://runway, whose mesh
         URIs still needed GZ_SIM_RESOURCE_PATH (empty-world bug). -->
    <model name="ground">
      <static>1</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>800 800 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>800 800 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.48 0.4 1</ambient>
            <diffuse>0.45 0.48 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- takeoff strip marking (visual only) -->
    <model name="runway_strip">
      <static>1</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="strip">
          <geometry>
            <box>
              <size>150 8 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.27 1</ambient>
            <diffuse>0.25 0.25 0.27 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- the drone: F450 with OV5647-style camera -->
    <include>
      <uri>/home/ubuntu/Desktop/ROS2_sim/world_sim/models/sentinel_f450</uri>
      <pose degrees="true">0 0 0.195 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- x = 10: gap test – two walls, 5 m gap between inner faces    -->
    <!-- ============================================================ -->
    <model name="wall_gap_left">
      <static>1</static>
      <pose>10 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 1 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 1 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_gap_right">
      <static>1</static>
      <pose>10 -3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 1 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 1 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.6 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- x = 18: merge test – two boxes only 0.3 m apart (no flyable  -->
    <!-- gap) – the detector must report ONE block, not two.          -->
    <!-- ============================================================ -->
    <model name="box_merge_left">
      <static>1</static>
      <pose>18 0.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.2 1</ambient>
            <diffuse>0.55 0.38 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_merge_right">
      <static>1</static>
      <pose>18 -0.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.2 1</ambient>
            <diffuse>0.55 0.38 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- x = 24-36: pylon slalom                                      -->
    <!-- ============================================================ -->
    <model name="pylon_1">
      <static>1</static>
      <pose>24 2.5 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.5 0.1 1</ambient>
            <diffuse>0.95 0.5 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pylon_2">
      <static>1</static>
      <pose>28 -2.5 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.5 0.1 1</ambient>
            <diffuse>0.95 0.5 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pylon_3">
      <static>1</static>
      <pose>32 2.5 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.5 0.1 1</ambient>
            <diffuse>0.95 0.5 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pylon_4">
      <static>1</static>
      <pose>36 -2.5 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.5 0.1 1</ambient>
            <diffuse>0.95 0.5 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- corridor markers -->
    <model name="marker_left">
      <static>1</static>
      <pose>42 5 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.2 1</ambient>
            <diffuse>0.9 0.9 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="marker_right">
      <static>1</static>
      <pose>42 -5 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.2 1</ambient>
            <diffuse>0.9 0.9 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- x = 44: long wall spanning y=-7..3 – only the right side is  -->
    <!-- open, forcing a detour                                       -->
    <!-- ============================================================ -->
    <model name="detour_wall">
      <static>1</static>
      <pose>44 -2 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 10 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 10 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- x = 52-56: box cluster + tall box                            -->
    <!-- ============================================================ -->
    <model name="box_cluster_1">
      <static>1</static>
      <pose>52 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.2 1</ambient>
            <diffuse>0.55 0.38 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_cluster_2">
      <static>1</static>
      <pose>54 6.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.2 1</ambient>
            <diffuse>0.55 0.38 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_cluster_3">
      <static>1</static>
      <pose>56 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.2 1</ambient>
            <diffuse>0.55 0.38 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="tall_box">
      <static>1</static>
      <pose>52 -4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
